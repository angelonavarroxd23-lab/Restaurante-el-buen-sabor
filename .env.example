# Copie este archivo a .env (o ejecute scripts/init-env.sh, que genera valores aleatorios).
# .env está en .gitignore: NUNCA lo suba al repositorio.

# --- MySQL ---
MYSQL_ROOT_PASSWORD=CHANGE_ME_root
DB_NAME=restaurante_db
DB_USER=restaurante_app
DB_PASSWORD=CHANGE_ME_app

# --- Backend ---
# Mínimo 32 caracteres. Generar con: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_jwt_secret_min_32_chars_long
# true = conserva el acceso de demostración original (ver README)
DEMO_LOGIN_ENABLED=true
# Orígenes extra para CORS (solo necesario si el frontend se sirve desde otro origen)
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Puertos publicados en el host ---
FRONTEND_PORT=4200
BACKEND_PORT=8080
DB_PORT=3306
